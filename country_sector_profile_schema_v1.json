    },
    {
      "metricKey": "ruleOfLawWgiEstimate",
      "sectorId": "governanceAndInstitutions",
      "title": "Rule of law (WGI estimate)",
      "preference": "higher_is_stronger"
    },
    {
      "metricKey": "controlOfCorruptionWgiEstimate",
      "sectorId": "governanceAndInstitutions",
      "title": "Control of corruption (WGI estimate)",
      "preference": "higher_is_stronger"
    },
    {
      "metricKey": "politicalStabilityWgiEstimate",
      "sectorId": "governanceAndInstitutions",
      "title": "Political stability (WGI estimate)",
      "preference": "higher_is_stronger"
    }
  ],
  "unavailableModelSlots": [
    {
      "id": "diplomaticInfluenceIndex",
      "sectorId": "diplomacyAndForeignAffairs",
      "title": "Diplomatic influence",
      "status": "NOT_SCORED_REQUIRED_DATA_MISSING",
      "missingInputs": [
        "alliance and treaty participation",
        "international voting/alignment history",
        "diplomatic network/representation coverage"
      ],
      "note": "No score is generated until comparable sourced inputs and a versioned formula are defined."
    },
    {
      "id": "militaryCapabilityIndex",
      "sectorId": "defenseAndSecurity",
      "title": "Military capability",
      "status": "NOT_SCORED_REQUIRED_DATA_MISSING",
      "missingInputs": [
        "personnel strength",
        "equipment readiness and inventory",
        "logistics and sustainment",
        "training/readiness",
        "domestic defence production"
      ],
      "note": "Military expenditure is not a substitute for military capability; no capability score is fabricated."
    },
    {
      "id": "resourceDependencyIndex",
      "sectorId": "naturalResources",
      "title": "Resource dependency",
      "status": "NOT_SCORED_REQUIRED_DATA_MISSING",
      "missingInputs": [
        "resource-level imports",
        "resource-level domestic production",
        "resource-level exports",
        "consumption or demand"
      ],
      "note": "A missing resource-context record is not evidence that a country has no resources."
    },
    {
      "id": "industrialResilienceIndex",
      "sectorId": "industryAndProduction",
      "title": "Industrial resilience",
      "status": "NOT_SCORED_REQUIRED_DATA_MISSING",
      "missingInputs": [
        "capacity utilization",
        "supplier concentration",
        "skills/labour pipeline",
        "logistics reliability",
        "critical input import shares"
      ],
      "note": "The industrial scale proxy must not be presented as industrial resilience."
    }
  ],
  "extensionContract": {
    "additiveOnly": true,
    "addSectorWithoutChangingCountryRoster": true,
    "customAttributesField": "extensions.customAttributes",
    "customMetricsField": "extensions.customMetrics",
    "addNewMetricBy": [
      "add a definition to fieldCatalog",
      "define unit, type, source policy and missing-value semantics",
      "include year, source identifier, source URL, method, observation status and notes",
      "add a schema/test for the new field",
      "rebuild and verify coverage"
    ],
    "metricDefinitionRequiredFields": [
      "key",
      "sectorId",
      "title",
      "type",
      "unit",
      "sourcePolicy",
      "nullable",
      "description"
    ],
    "allowedStatusExamples": [
      "OBSERVED_SOURCE_VALUE",
      "WORLD_BANK_API_OBSERVATION",
      "DERIVED_SAME_YEAR_OBSERVATIONS",
      "MODELLED_GAME_VALUE",
      "NOT_IMPORTED",
      "NO_SOURCE_OBSERVATION",
      "SOURCE_REFRESH_FAILED",
      "IDENTITY_MISMATCH",
      "NOT_COMPARABLE",
      "NOT_ASSESSED"
    ],
    "formulaOperators": [
      "ratio_percent",
      "sum_ratio_percent",
      "multiply_percent",
      "negative_floor_zero",
      "weightedPercentile"
    ],
    "futureSeriesContract": [
      "countryIso3",
      "fieldKey",
      "value",
      "unit",
      "observationYear",
      "sourceId",
      "sourceName",
      "sourceUrl",
      "method",
      "status",
      "confidence",
      "notes"
    ]
  }
}
