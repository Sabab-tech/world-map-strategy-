{
  "schemaVersion": 2,
  "modelVersion": "1.1.0",
  "title": "OMEGA NPC National Macro-Economy Evidence-Backed Progression Rules",
  "purpose": "Advance NPC macro indicators from country-specific source baselines, same-country industrial output batches, settled trade ledgers, project lifecycle evidence, Finance progress and observed foreign-policy conditions. Projections remain explicitly modelled and never create cash, stock, production, settlements or official national-account observations.",
  "roster": {
    "manifestPath": "minister_country_roster_manifest_v1.json",
    "identityField": "ISO3",
    "manifestCountryMap": "countries"
  },
  "baseline": {
    "source": "economy_global_profiles_v1.json",
    "metadataSource": "FinanceMinistry.getProfileMetadata",
    "generalDataCacheApi": "Omega.CountryGeneralData.getCountryRecord",
    "missingValuePolicy": "NULL_REMAINS_UNOBSERVED",
    "metrics": [
      {
        "id": "gdpCurrentUsd",
        "profileMetric": "gdpCurrentUsd",
        "generalDataMetric": "gdpCurrentUsd",
        "unit": "USD_CURRENT",
        "currency": "USD"
      },
      {
        "id": "gdpGrowthPct",
        "profileMetric": "gdpGrowthPct",
        "generalDataMetric": "gdpGrowthPct",
        "unit": "PERCENT_PER_YEAR"
      },
      {
        "id": "inflationRatePct",
        "profileMetric": "inflationRatePct",
        "generalDataMetric": "inflationPct",
        "unit": "PERCENT_PER_YEAR"
      },
      {
        "id": "unemploymentRatePct",
        "profileMetric": "unemploymentRatePct",
        "generalDataMetric": "unemploymentRatePct",
        "unit": "PERCENT"
      },
      {
        "id": "governmentBudgetBalanceUsd",
        "profileMetric": "governmentBudgetBalanceUsd",
        "generalDataMetric": "budgetBalanceUsd",
        "unit": "USD_CURRENT",
        "currency": "USD"
      },
      {
        "id": "publicDebtUsd",
        "profileMetric": "publicDebtUsd",
        "generalDataMetric": "publicDebtUsd",
        "unit": "USD_CURRENT",
        "currency": "USD"
      },
      {
        "id": "tradeBalanceUsd",
        "profileMetric": "tradeBalanceUsd",
        "generalDataMetric": "tradeBalanceUsd",
        "unit": "USD_CURRENT",
        "currency": "USD"
      },
      {
        "id": "foreignExchangeReservesUsd",
        "profileMetric": "foreignExchangeReservesUsd",
        "generalDataMetric": "fxReservesUsd",
        "unit": "USD_CURRENT",
        "currency": "USD"
      },
      {
        "id": "exchangeRateLocalPerUsd",
        "profileMetric": "exchangeRateLocalPerUsd",
        "generalDataMetric": "exchangeRateLocalPerUsd",
        "unit": "LOCAL_CURRENCY_PER_USD"
      },
      {
        "id": "grossCapitalFormationPctGdp",
        "profileMetric": "grossCapitalFormationPctGdp",
        "generalDataMetric": "grossCapitalFormationPctGdp",
        "unit": "PERCENT_OF_GDP"
      }
    ]
  },
  "liveSignals": [
    {
      "id": "recordedProductionCapacity",
      "path": "economy.productionCapacity",
      "type": "number",
      "unit": null,
      "authority": "COUNTRY_ECONOMY_STATE",
      "meaning": "Recorded game production capacity; unit is unavailable unless separately declared."
    },
    {
      "id": "recordedProductionAssetCount",
      "path": "economy.productionAssets",
      "type": "array-count",
      "unit": "GAME_ASSET_RECORDS",
      "authority": "COUNTRY_ECONOMY_STATE",
      "meaning": "Count of recorded game production asset rows; not a real-world facility census."
    },
    {
      "id": "autonomousProjectStatusCounts",
      "path": "projects.registry",
      "type": "status-counts",
      "unit": "PROJECT_RECORDS",
      "authority": "COUNTRY_PROJECT_LIFECYCLE",
      "statusGroups": {
        "active": [
          "REQUESTED",
          "APPROVED",
          "UNDER_CONSTRUCTION",
          "COMMISSIONING",
          "IN_PROGRESS"
        ],
        "completed": [
          "COMPLETED",
          "OPERATIONAL"
        ],
        "blocked": [
          "BLOCKED",
          "SETTLEMENT_BLOCKED",
          "COMMISSIONING_BLOCKED",
          "FAILED"
        ],
        "cancelled": [
          "CANCELLED",
          "REJECTED"
        ]
      }
    },
    {
      "id": "settledInternationalTradeCount",
      "path": "trade.globalTradeLedger.settlements",
      "type": "settled-record-count",
      "unit": "SETTLED_TRADE_RECORDS",
      "authority": "GLOBAL_TRADE_SETTLEMENT_LEDGER",
      "requiredStatus": "SETTLED",
      "meaning": "Counts only actual SETTLED ledger records; offers, bids and market matches are excluded."
    },
    {
      "id": "financeLedgerEntryCount",
      "path": "finance.omegaFinance.ledger",
      "type": "array-count",
      "unit": "FINANCE_LEDGER_RECORDS",
      "authority": "FINANCE_MINISTRY_LEDGER",
      "meaning": "Record count only; Finance remains the sole cash and expenditure authority."
    },
    {
      "id": "treasuryBalanceAvailability",
      "path": "finance.available",
      "type": "presence",
      "unit": "BOOLEAN",
      "authority": "FINANCE_MINISTRY_TREASURY",
      "meaning": "Indicates whether an authoritative Treasury balance is recorded; the macro checkpoint does not mirror the balance."
    },
    {
      "id": "financialTransmissionRealGdpIndex",
      "path": "economy.financialTransmission.realGDPIndex",
      "type": "number",
      "unit": "INDEX",
      "authority": "MODELLED_DERIVED_FINANCIAL_TRANSMISSION",
      "meaning": "Existing derived projection; never treated as observed GDP."
    },
    {
      "id": "financialTransmissionHouseholdPurchasingPowerIndex",
      "path": "economy.financialTransmission.householdPurchasingPowerIndex",
      "type": "number",
      "unit": "INDEX",
      "authority": "MODELLED_DERIVED_FINANCIAL_TRANSMISSION",
      "meaning": "Existing derived projection; not a direct household survey observation."
    },
    {
      "id": "currentNominalGdpUsd",
      "path": "economy.gdp",
      "type": "number",
      "unit": "USD_CURRENT",
      "authority": "FINANCE_MINISTRY_GDP_PROGRESSION",
      "meaning": "Current Finance-owned nominal GDP level; distinct from the historical baseline."
    },
    {
      "id": "currentGdpGrowthPct",
      "path": "economy.gdp_growth",
      "type": "number",
      "unit": "PERCENT_PER_YEAR",
      "authority": "FINANCE_MINISTRY_MACRO_RUNTIME",
      "meaning": "Current Finance-owned annual GDP growth input, after existing fiscal and macro policy."
    },
    {
      "id": "currentInflationPct",
      "path": "economy.inflation",
      "type": "number",
      "unit": "PERCENT_PER_YEAR",
      "authority": "FINANCE_AND_MONETARY_RUNTIME",
      "meaning": "Current country inflation input when present; no fallback is invented."
    },
    {
      "id": "currentUnemploymentPct",
      "path": "economy.unemployment_rate",
      "type": "number",
      "unit": "PERCENT",
      "authority": "FINANCE_AND_LABOUR_RUNTIME",
      "meaning": "Current country unemployment input when present."
    },
    {
      "id": "consumerPriceIndex",
      "path": "economy.financialTransmission.cpiIndex",
      "type": "number",
      "unit": "INDEX",
      "authority": "MODELLED_FINANCIAL_TRANSMISSION",
      "meaning": "Existing CPI index (100 = opening model baseline); not an official CPI observation."
    },
    {
      "id": "producerCostIndex",
      "path": "economy.financialTransmission.producerCostIndex",
      "type": "number",
      "unit": "INDEX",
      "authority": "MODELLED_FINANCIAL_TRANSMISSION",
      "meaning": "Existing producer-cost index (100 = opening model baseline); not an official PPI observation."
    }
  ],
  "persistence": {
    "ownerMinistry": "economy",
    "statePath": "economy.npcMacroEconomy",
    "commandType": "OMEGA_NPC_MACRO_ECONOMY_CHECKPOINT",
    "historyLimit": 24,
    "sameTurnPolicy": "ONE_CHECKPOINT_PER_COUNTRY_PER_COMMITTED_TURN",
    "fingerprint": "STABLE_JSON_FNV1A32"
  },
  "scheduler": {
    "existingSchedulerOnly": true,
    "tiers": [
      "ACTIVE",
      "MACRO"
    ],
    "playerCountryAutomation": false,
    "perTurnNetworkIo": false
  },
  "progression": {
    "annualizationMs": 31536000000,
    "simulationTurnDurationMs": 86400000,
    "maxAnnualIndustryGrowthPct": 18,
    "maxGrowthContributionPp": 2.5,
    "maximumProjectedGrowthPct": 25,
    "minimumProjectedGrowthPct": -25,
    "maximumProjectedInflationPct": 100,
    "maximumAnnualUnemploymentChangePp": 2,
    "industryGrowthSensitivity": 0.2,
    "tradeBalanceToGdpSensitivity": 0.08,
    "treatyTradeAccessSensitivity": 0.15,
    "tradeDisruptionPerCountry": 0.12,
    "investmentIndexPointsPerCompletedProject": 0.8,
    "maximumInvestmentActivityIndex": 250,
    "investmentGrowthPpPerCompletedProject": 0.04,
    "tariffInflationSensitivity": 0.025,
    "maximumTariffInflationPp": 2,
    "warInflationPpPerCountry": 0.08,
    "maximumWarInflationPp": 1.5,
    "producerCostInflationSensitivity": 0.25,
    "unemploymentGrowthSensitivity": 0.12
  },
  "policyEffects": {
    "tradePolicyFactors": {
      "FREE_TRADE": 1.1,
      "OPEN_MARKET": 1.08,
      "BALANCED": 1,
      "PROTECTIONIST": 0.9,
      "RESTRICTIVE": 0.85,
      "ISOLATIONIST": 0.75
    },
    "foreignPolicyFactors": {
      "COOPERATIVE": 1.06,
      "DIPLOMATIC": 1.04,
      "NON_ALIGNED": 1,
      "NEUTRAL": 1,
      "ISOLATIONIST": 0.88,
      "HOSTILE": 0.82
    },
    "playerRelationFactorBase": 0.85,
    "playerRelationFactorRange": 0.3,
    "minimumPlayerRelationFactor": 0.85,
    "maximumPlayerRelationFactor": 1.15,
    "minimumCombinedFactor": 0.6,
    "maximumCombinedFactor": 1.25,
    "missingPolicyFactor": 1,
    "authority": "GLOBAL_SIMULATION_RULESET_ASSUMPTIONS_NOT_NATIONAL_STATISTICAL_ESTIMATES"
  }
}
