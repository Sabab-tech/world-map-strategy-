{
  "schemaVersion": "1.0.0",
  "baselineYear": 2015,
  "currency": "USD",
  "annualizationMs": 31536000000,
  "simulationTurnDurationMs": 86400000,
  "startingTreasuryPercentOfGDP": 2,
  "defaultTaxRatePct": 18,
  "defaultPolicyInterestRatePct": 3,
  "defaultDeficitPercentOfGDPWhenUnobserved": 3,
  "minimumTaxRatePct": 0,
  "maximumTaxRatePct": 60,
  "minimumPolicyInterestRatePct": 0,
  "maximumPolicyInterestRatePct": 40,
  "maximumBorrowTransactionPercentOfGDP": 5,
  "maximumDebtToGDPForNewBorrowingPct": 300,
  "maximumLedgerEntries": 500,
  "influenceWeights": {
    "gdp": 0.55,
    "population": 0.2,
    "foreignExchangeReserves": 0.15,
    "tradeBalanceToGDP": 0.1
  },
  "fiscalRiskBounds": {
    "debtToGDPPercent": 300,
    "inflationPercent": 25,
    "unemploymentPercent": 35,
    "deficitToGDPPercent": 20
  },
  "budgetModel": {
    "taxRevenueFormula": "GDP multiplied by the active game-model tax rate.",
    "spendingFormula": "For a country with a baseline budget balance, modeled spending equals modeled revenue minus that baseline balance. If balance is missing, use the configured game-rule deficit ratio.",
    "transparency": "Modeled fiscal flows are gameplay assumptions, not observed national budget data."
  },
  "defaultMinimumReservePctOfAnnualSpending": 0,
  "automaticNationalReserve": {
    "enabledForNpcCountries": true,
    "policyVersion": 2,
    "requiresReconciledFiscalPeriod": true,
    "targetCoverageDays": {
      "normal": 90,
      "highRisk": 120,
      "unknown": 120
    },
    "highRiskIndexThreshold": 60,
    "coverageTiers": [
      {
        "id": "BELOW_30_DAYS",
        "maxCoverageDaysExclusive": 30,
        "contributionPctOfOperatingSurplus": 50
      },
      {
        "id": "DAYS_30_TO_59",
        "maxCoverageDaysExclusive": 60,
        "contributionPctOfOperatingSurplus": 40
      },
      {
        "id": "DAYS_60_TO_89",
        "maxCoverageDaysExclusive": 90,
        "contributionPctOfOperatingSurplus": 25
      },
      {
        "id": "DAYS_90_TO_119",
        "maxCoverageDaysExclusive": 120,
        "contributionPctOfOperatingSurplus": 10
      },
      {
        "id": "AT_OR_ABOVE_120_DAYS",
        "maxCoverageDaysExclusive": null,
        "contributionPctOfOperatingSurplus": 0
      }
    ],
    "surplusBasis": "TAX_AND_EXTERNAL_CASH_INFLOWS_MINUS_GOVERNMENT_SPENDING_EXTERNAL_DEBITS_INTEREST_AND_PRINCIPAL_REPAYMENT",
    "excludeBorrowingProceeds": true,
    "spendingPolicy": "NPC trade and ordinary government spending preserve the earmarked reserve; only authorized emergency and debt-service expenditure may release it. External Treasury shortfalls are separately recorded and are not classified as authorized releases."
  },
  "budgetAllocationPolicy": "ANNUAL_PLAN_SHARES_MUST_NOT_EXCEED_100_PERCENT",
  "cashFlowPolicy": {
    "modeledTaxRevenue": "Accrues to the live Treasury by simulated duration and is mirrored into finance.taxRevenue and finance.revenue.",
    "plannedSpending": "Annual budget allocation is a spending ceiling, not an automatic expense. Treasury falls only for actual Finance actions, external runtime outflows, and accrued debt interest.",
    "externalSubsystems": "Cash changes made by other ministries/resource/trade systems are reconciled from finance.available and recorded as externally classified credits/debits when the source action cannot be reliably inferred.",
    "estimates": "Country-sector output and projected tax contributions use finance_sector_registry_v1.json default shares and are game estimates, not observed statistics."
  },
  "maximumFiscalPeriodHistory": 12,
  "maximumFiscalTransactionIds": 2048,
  "sectorJournalV1": {
    "schemaVersion": 1,
    "currency": "USD",
    "sourceAuthority": "OMEGA_FINANCE_MINISTRY",
    "postingScope": "GOVERNMENT_SECTOR_FINANCE_CASH_TRANSACTIONS_ONLY",
    "transactionRules": {
      "EXPENSE": {
        "type": "PAIR",
        "sectorId": "government",
        "amountField": "amountUsd",
        "debitAccount": "GOVERNMENT:OPERATING_EXPENSE:{department}:{category}",
        "creditAccount": "GOVERNMENT:TREASURY_CASH",
        "accountingBasis": "RECORDED_GAME_CASH_EXPENSE",
        "provenance": "RECORDED_GAME_RUNTIME",
        "debitAccountByCategory": {
          "purchase": "GOVERNMENT:CAPITAL_ASSETS:{department}",
          "investment": "GOVERNMENT:CAPITAL_ASSETS:{department}"
        }
      },
      "EXPENSE_ROLLBACK": {
        "type": "PAIR",
        "sectorId": "government",
        "amountField": "amountUsd",
        "absoluteValue": true,
        "debitAccount": "GOVERNMENT:TREASURY_CASH",
        "creditAccount": "GOVERNMENT:OPERATING_EXPENSE:{department}:{category}",
        "accountingBasis": "RECORDED_GAME_CASH_EXPENSE_REVERSAL",
        "provenance": "RECORDED_GAME_RUNTIME_REVERSAL",
        "creditAccountByCategory": {
          "purchase": "GOVERNMENT:CAPITAL_ASSETS:{department}",
          "investment": "GOVERNMENT:CAPITAL_ASSETS:{department}"
        }
      },
      "BORROW": {
        "type": "PAIR",
        "sectorId": "government",
        "amountField": "amountUsd",
        "debitAccount": "GOVERNMENT:TREASURY_CASH",
        "creditAccount": "GOVERNMENT:PUBLIC_DEBT",
        "accountingBasis": "RECORDED_SOVEREIGN_BORROWING",
        "provenance": "RECORDED_GAME_RUNTIME"
      },
      "DEBT_REPAYMENT": {
        "type": "PAIR",
        "sectorId": "government",
        "amountField": "amountUsd",
        "debitAccount": "GOVERNMENT:PUBLIC_DEBT",
        "creditAccount": "GOVERNMENT:TREASURY_CASH",
        "accountingBasis": "RECORDED_SOVEREIGN_PRINCIPAL_REPAYMENT",
        "provenance": "RECORDED_GAME_RUNTIME"
      },
      "WORLD_BANK_DEBT_SERVICE": {
        "type": "SPLIT_DEBIT",
        "sectorId": "government",
        "totalAmountField": "amountUsd",
        "debitComponents": [
          {
            "accountId": "GOVERNMENT:PUBLIC_DEBT",
            "amountField": "principalPaidUsd"
          },
          {
            "accountId": "GOVERNMENT:INTEREST_EXPENSE",
            "amountField": "interestPaidUsd"
          }
        ],
        "creditAccount": "GOVERNMENT:TREASURY_CASH",
        "accountingBasis": "RECORDED_WORLD_BANK_DEBT_SERVICE",
        "provenance": "RECORDED_GAME_RUNTIME"
      }
    },
    "excludedFlowClasses": [
      "MODELED_TAX_REVENUE_WITHOUT_TRANSACTION_LEVEL_TAXPAYER_COUNTERPARTY",
      "EXTERNAL_TREASURY_RECONCILIATION_WITH_UNRESOLVED_SOURCE_ACCOUNT",
      "BUDGET_ALLOCATION_TRANSFERS_ARE_NON_CASH",
      "HOUSEHOLD_AND_FIRM_SECTOR_SOURCES_ARE_NOT_COMPLETE_IN_THIS_SLICE"
    ]
  }
}
