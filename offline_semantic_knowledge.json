  },
  "semantic_control_primitives": {
    "schema_version":"1.0.0",
    "purpose":"Turn Batch 02 measurement, temporal and comparison concepts into semantic control primitives rather than dictionary entries.",
    "global_contract": {
      "required_layers":["semantic_identity","measurement_semantics","temporal_semantics","causal_role","strategic_role","constraint_model","allowed_composition","invalid_composition","runtime_resolution_policy","uncertainty_policy","provenance_policy","execution_boundary","ai_reasoning_usage","diagnostic_usage","forecast_usage","comparison_usage","game_state_mutation_authority"],
      "principle":"A language concept describes meaning and admissible composition; it never creates world facts, numeric effects, capability or authority."
    },
    "QUANTITY": {
      "semantic_identity":"Absolute measurable magnitude tied to a subject and scope.",
      "measurement_semantics":{"kind":"absolute","fields":["value","unit","dimension","subject","temporal_scope","provenance","precision","uncertainty","status"],"stock_flow_guard":true,"comparison_compatibility":"same_dimension_required"},
      "temporal_semantics":{"scope":"observation_or_measurement_scope","requires_alignment_for_comparison":true},
      "causal_role":"measurement_only",
      "strategic_role":"evidence_for_state_assessment",
      "constraint_model":["dimension_compatibility","unit_compatibility","subject_required","scope_required_for_time_sensitive_state"],
      "allowed_composition":["STATE_VARIABLE","UNIT","TIME_POINT","TIME_PERIOD","BASELINE","CHANGE_DELTA"],
      "invalid_composition":["QUANTITY_as_RATE_without_temporal_denominator","mix_stock_and_flow_without_explicit_conversion"],
      "runtime_resolution_policy":{"strategy":"resolve_value_with_unit_and_subject","numeric_source":"GAME_DATA_ONLY","never":["infer_world_value","invent_unit","invent_conversion"]},
      "uncertainty_policy":"Preserve estimated, measured, modeled and confirmed status; never silently upgrade confidence.",
      "provenance_policy":"Every resolved world quantity retains its authoritative source and observation status.",
      "execution_boundary":"READ_ONLY_UNLESS_A_VALIDATED_ACTION_FRAME_CONSUMES_IT",
      "ai_reasoning_usage":"Evidence magnitude; not an action or state mutation.",
      "diagnostic_usage":"Detect unit, dimension, scope and stock-flow mismatches.",
      "forecast_usage":"Input feature only; forecast engine owns projections.",
      "comparison_usage":"Comparable only after dimensional and temporal alignment.",
      "game_state_mutation_authority":"NONE"
    },
    "RATE": {
      "semantic_identity":"Quantity normalized by an explicit temporal denominator.",
      "measurement_semantics":{"kind":"flow_or_throughput","fields":["value","unit","time_denominator","target","mode"],"modes":["instantaneous","average","sustained","peak","planned","observed"],"capacity_actual_guard":true},
      "temporal_semantics":{"requires":"TIME_UNIT_OR_EXPLICIT_INTERVAL","denominator_is_semantic":true},
      "causal_role":"describes_flow_or_throughput",
      "strategic_role":"capacity_and_production_evidence",
      "constraint_model":["time_denominator_required","unit_dimension_required","planned_vs_observed_preserved"],
      "allowed_composition":["QUANTITY","UNIT","TIME_DURATION","TIME_PERIOD","CAPACITY","PRODUCTION"],
      "invalid_composition":["RATE_without_time_basis","RATE_equated_to_QUANTITY","capacity_equated_to_actual_throughput"],
      "runtime_resolution_policy":{"strategy":"build_rate_frame","requires":["value","unit","time_basis","target"],"never":["collapse_into_quantity"]},
      "uncertainty_policy":"Preserve observed, estimated, planned and peak/sustained qualifiers.",
      "provenance_policy":"Retain source and measurement mode.",
      "execution_boundary":"READ_ONLY_UNLESS_CONSUMED_BY_VALIDATED_ACTION",
      "ai_reasoning_usage":"Flow/throughput evidence and constraint reasoning.",
      "diagnostic_usage":"Catch missing denominators and capacity/actual conflation.",
      "forecast_usage":"Projection input with explicit horizon.",
      "comparison_usage":"Compare only rates with compatible dimensions and temporal basis.",
      "game_state_mutation_authority":"NONE"
    },
    "RATIO": {
      "semantic_identity":"Ordered relational measurement between numerator and denominator.",
      "measurement_semantics":{"kind":"ordered_relation","fields":["numerator","denominator","value","dimension","scope"],"ordering_significant":true,"zero_denominator_guard":true},
      "temporal_semantics":"Numerator and denominator must share a compatible scope.",
      "causal_role":"relational_measurement_only",
      "strategic_role":"dependency_intensity_or_relative_structure_evidence",
      "constraint_model":["ordered_operands","dimension_compatibility","nonzero_denominator_when_dividing"],
      "allowed_composition":["QUANTITY","STATE_VARIABLE","PERCENTAGE"],
      "invalid_composition":["swap_numerator_denominator_without_semantic_change","treat_ratio_as_percentage_without_conversion"],
      "runtime_resolution_policy":{"strategy":"build_ordered_ratio","requires":["numerator","denominator"],"zero_denominator":"INVALID"},
      "uncertainty_policy":"Propagate operand uncertainty; do not manufacture precision.",
      "provenance_policy":"Retain provenance of both operands.",
      "execution_boundary":"READ_ONLY",
      "ai_reasoning_usage":"Compare ordered magnitudes and structural dependencies.",
      "diagnostic_usage":"Detect operand reversal and dimensional incompatibility.",
      "forecast_usage":"Derived metric only when both inputs are forecast-valid.",
      "comparison_usage":"Direction-sensitive; A/B is not B/A.",
      "game_state_mutation_authority":"NONE"
    },
    "PERCENTAGE": {
      "semantic_identity":"Normalized relative magnitude expressed on a 100-scale.",
      "measurement_semantics":{"kind":"normalized_relative_expression","fields":["value","target","baseline","direction","scope"],"not_an_action":true},
      "temporal_semantics":"Baseline and target must be temporally aligned or explicitly scoped.",
      "causal_role":"magnitude_expression_only",
      "strategic_role":"communicates normalized movement or share",
      "constraint_model":["baseline_required_for_change_interpretation","direction_separate_from_magnitude"],
      "allowed_composition":["RELATIVE_CHANGE","CHANGE_DELTA","RATIO","BASELINE"],
      "invalid_composition":["percentage_as_action","percentage_as_state_without_target_or_context"],
      "runtime_resolution_policy":{"strategy":"build_relative_measurement","requires":["numeric_value"],"never":["interpret_as_action"]},
      "uncertainty_policy":"Preserve uncertainty and rounding metadata.",
      "provenance_policy":"Retain source and baseline provenance.",
      "execution_boundary":"READ_ONLY",
      "ai_reasoning_usage":"Magnitude component; direction and target are separate semantic slots.",
      "diagnostic_usage":"Detect confusion between percent, percentage points and absolute units.",
      "forecast_usage":"Display or normalized forecast metric; forecast engine owns value.",
      "comparison_usage":"Requires explicit baseline for relative-change meaning.",
      "game_state_mutation_authority":"NONE"
    },
    "UNIT": {
      "semantic_identity":"Dimensional measurement contract and conversion identity.",
      "measurement_semantics":{"dimensions":["MASS","VOLUME","ENERGY","CURRENCY","COUNT","TIME","AREA","DISTANCE","RATIO"],"fields":["symbol","dimension","scale","conversion_registry_key"]},
      "temporal_semantics":"TIME units define denominators or durations; they are not temporal anchors.",
      "causal_role":"none",
      "strategic_role":"ensures comparable measurement semantics",
      "constraint_model":["dimension_match","conversion_registry_authority"],
      "allowed_composition":["QUANTITY","RATE","PRICE","TIME_DURATION","RATIO"],
      "invalid_composition":["invent_conversion_factor","cross_dimension_conversion_without_registry"],
      "runtime_resolution_policy":{"strategy":"resolve_unit_from_unit_registry","requires":["authoritative_or_builtin_unit_registry"],"never":["invent_conversion_factor"]},
      "uncertainty_policy":"Unit identity is deterministic; conversion uncertainty belongs to the conversion registry.",
      "provenance_policy":"Conversion authority is retained when conversion occurs.",
      "execution_boundary":"READ_ONLY",
      "ai_reasoning_usage":"Dimensional validation and normalization.",
      "diagnostic_usage":"Primary guard against incompatible arithmetic.",
      "forecast_usage":"Used to normalize forecast outputs.",
      "comparison_usage":"Required for dimensionally valid comparison.",
      "game_state_mutation_authority":"NONE"
    },
    "TIME_POINT": {
      "semantic_identity":"Single temporal anchor at which a state, event or observation is referenced.",
      "measurement_semantics":"Provides temporal identity, not elapsed magnitude.",
      "temporal_semantics":{"kind":"anchor","fields":["instant","calendar","game_clock_reference"]},
      "causal_role":"anchors_observation_or_event",
      "strategic_role":"pins state interpretation to a moment",
      "constraint_model":["calendar_or_game_clock_required"],
      "allowed_composition":["STATE_VARIABLE","EVENT","BASELINE","TIME_PERIOD"],
      "invalid_composition":["treat_as_duration","invent_current_date"],
      "runtime_resolution_policy":{"strategy":"resolve_temporal_reference","requires":["calendar_or_game_clock"],"never":["invent_current_date"]},
      "uncertainty_policy":"Preserve precision of the temporal anchor.",
      "provenance_policy":"Retain whether the anchor came from game clock, dataset or explicit user input.",
      "execution_boundary":"READ_ONLY",
      "ai_reasoning_usage":"Temporal alignment and state anchoring.",
      "diagnostic_usage":"Detect mismatched observation times.",
      "forecast_usage":"Defines forecast origin or target instant.",
      "comparison_usage":"Aligns baselines and observations.",
      "game_state_mutation_authority":"NONE"
    },
    "TIME_DURATION": {
      "semantic_identity":"Length of elapsed or allocated time.",
      "measurement_semantics":{"kind":"temporal_length","fields":["value","time_unit","start","end"]},
      "temporal_semantics":{"kind":"execution_or_decay_horizon","not_an_anchor":true},
      "causal_role":"bounds_execution_or_effect_horizon",
      "strategic_role":"defines duration of policy, investment, production or decay effects",
      "constraint_model":["duration_value","time_unit"],
      "allowed_composition":["ACTION_INCREASE","ACTION_DECREASE","INVESTMENT","EVENT","FORECAST"],
      "invalid_composition":["treat_as_single_date","use_as_analysis_interval_without_endpoints_or_interval_semantics"],
      "runtime_resolution_policy":{"strategy":"build_duration_frame","requires":["duration_value","time_unit"]},
      "uncertainty_policy":"Preserve approximate duration when source is approximate.",
      "provenance_policy":"Retain source of horizon.",
      "execution_boundary":"READ_ONLY_INPUT_TO_VALIDATED_EXECUTION",
