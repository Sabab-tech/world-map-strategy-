# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# GitHub App installed only on Sabab-tech/world-map-strategy-
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=Sabab-tech
GITHUB_REPO=world-map-strategy-

# Generate two different random secrets. Never commit real values.
# Example: openssl rand -hex 32
OMEGA_AGENT_ACCESS_TOKEN=
OMEGA_ACTION_SIGNING_SECRET=

# Optional comma-separated exact browser origins. Same-origin works without this.
AGENT_ALLOWED_ORIGINS=
PORT=8080
