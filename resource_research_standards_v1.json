  "authorityRules": {
    "observed": "Directly stated by source for the same asset and relevant date.",
    "derived": "Computed only from observed fields with an auditable formula.",
    "estimated": "Engineering/analogue estimate with explicit basis and confidence.",
    "simulated": "Gameplay scenario value. Never presented as observed real-world data.",
    "unobserved": "No sufficient evidence. Runtime must not silently fabricate it."
  },
  "simulationRules": {
    "longHorizonScenarioReserve": true,
    "scenarioReserveCanActAsGameEndowment": true,
    "scenarioReserveMustRemainMarkedSimulated": true,
    "researchCannotDirectlyIncreasePhysicalReserve": true,
    "explorationCanChangeModeledResourceStateOnlyThroughExplicitResearchEvent": true,
    "technologyChangesEngineeringAndRecoveryNotGeologicalExistence": true
  }
