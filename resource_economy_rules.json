      "gold": 0.7,
      "bauxite": 0.9,
      "phosphate": 0.75,
      "potash": 0.85,
      "iron_ore": 0.9,
      "coal": 0.88
    },
    "baselineDailyRates": {
      "rare_earth": 100,
      "cobalt": 150,
      "nickel": 800,
      "copper": 1000,
      "gold": 500,
      "bauxite": 4000,
      "phosphate": 4000,
      "potash": 3000,
      "iron_ore": 8000,
      "coal": 5000,
      "uranium": 50,
      "lithium": 500,
      "crude_oil": 10000,
      "natural_gas": 0.01
