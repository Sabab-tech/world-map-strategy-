      "OBSERVED",
      "SIMULATED"
    ],
    "syntheticSitePolicy": "SIMULATED_ONLY_WITH_EXPLICIT_RULESET",
    "missingCapacityPolicy": "USE_SIMULATION_BASELINE_AND_TAG_SIMULATED",
    "missingRecoverabilityPolicy": "DERIVE_WITH_RESOURCE_RULE_AND_TAG_ESTIMATED",
    "defaultEffortUtilization": 0.82,
    "constraintFactors": {
      "availability": 0.98,
      "maintenance": 0.96,
      "labor": 0.95,
      "power": 0.98,
      "water": 0.98,
      "logistics": 0.95,
      "security": 0.99
    },
    "recoveryFactors": {
      "rare_earth": 0.75,
      "lithium": 0.65,
      "cobalt": 0.8,
      "nickel": 0.82,
      "copper": 0.88,
      "crude_oil": 0.6,
