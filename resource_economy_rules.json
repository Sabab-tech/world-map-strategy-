    "baselineRateUnits": {
      "rare_earth": "TONNES_PER_DAY",
      "lithium": "TONNES_PER_DAY",
      "cobalt": "TONNES_PER_DAY",
      "nickel": "TONNES_PER_DAY",
      "copper": "TONNES_PER_DAY",
      "crude_oil": "BARRELS_PER_DAY",
      "natural_gas": "BCM_PER_YEAR",
      "uranium": "TONNES_PER_DAY",
      "gold": "TROY_OZ_PER_DAY",
      "bauxite": "TONNES_PER_DAY",
