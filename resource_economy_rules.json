{
  "schemaVersion": "1.0.0",
  "description": "OMEGA resource-to-industry-to-market fiscal simulation rules. These are game rules, not claims about any real country's tax law or industrial yields.",
  "inventory": {
    "legacyOpeningBalancePolicy": "PRESERVE_AND_MARK",
    "batchConsumptionPolicy": "FIFO",
    "sellableSurplusPolicy": "OBSERVED_INVENTORY_ONLY"
  },
  "fiscal": {
    "royaltyRate": 0.02,
    "resourceTaxRate": 0.01,
    "corporateTaxRate": 0.2,
    "exportDutyRate": 0,
    "otherReceiptRate": 0
  },
  "operatingAllocation": {
    "workerIncomeRate": 0.12,
    "transportRevenueRate": 0.05
  },
  "runtime": {
    "maxLedgerEntries": 2048,
    "maxBatches": 8192
  },
  "market": {
    "offerFractionOfObservedInventory": 0.25,
    "minOfferQuantity": 1
  },
  "actions": {
    "survey": {
      "durationTurns": 2,
      "maxResultRecords": 64
    },
    "facilityExpansion": {
      "capacityIncreaseFraction": 0.25,
      "durationTurns": 4,
      "budgetUnitsPerCapacityUnit": 10,
      "reservationExpiresAfterTurns": 64
    },
    "strategicBuffer": {
      "targetDays": 30,
      "maxTransferBatches": 128
    }
  },
  "demand": {
    "enabled": true,
    "ruleVersion": "1.0.0",
    "description": "Rule-driven national resource consumption. Profile coefficients are simulated game-native quantities per million people per simulation turn; physical-unit conversion is deliberately not inferred. Existing positive resource.consumption rates are pinned as the initial baseline.",
    "quantityBasis": "RESOURCE_NATIVE_UNITS_PER_SIMULATION_TURN",
    "baselinePolicy": "PIN_FIRST_OBSERVED_POSITIVE_RATE_OR_PROFILE_RATE",
    "defaultElasticities": {
      "population": 0.72,
      "gdpPerCapita": 0.2,
      "industry": 0.22,
      "military": 0.08,
      "price": 0.08
    },
    "minContextRatio": 0.25,
    "maxContextRatio": 4,
    "minFactor": 0.2,
    "maxFactor": 5,
    "priceFactorMin": 0.65,
    "priceFactorMax": 1.25,
    "wartimeMultiplier": 1.2,
    "defaultDomesticUseShare": 0.15,
    "stockCoverageTurns": 3,
    "procurementBufferTurns": 2,
    "maxPurchaseCoverageTurns": 6,
    "maxProcurementDecisionsPerCountryPerTurn": 2,
    "maxLedgerEntries": 1024,
    "automaticProcurement": {
      "enabled": true,
      "forPlayerCountry": false
    },
