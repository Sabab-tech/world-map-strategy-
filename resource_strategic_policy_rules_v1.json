      "BBL": 20000,
      "BBLS": 20000,
      "BARREL": 20000,
      "BARRELS": 20000,
      "BCM": 100,
      "MCM": 1000,
      "BCF": 100,
      "TCF": 1,
      "TROY_OUNCE": 1000000,
      "TROY_OUNCES": 1000000,
      "OZT": 1000000,
      "CARAT": 10000000,
      "CARATS": 10000000,
      "KG": 10000,
      "KILOGRAM": 10000,
      "KILOGRAMS": 10000,
      "DEFAULT": 10000
